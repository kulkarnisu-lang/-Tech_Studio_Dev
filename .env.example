# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_FIREBASE_*: Firebase Web API configuration for Firestore cloud sync
# (The applet includes pre-configured cloud fallback, but these allow custom project override)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Administrative access uses verified Google sign-in for devmarlow01@gmail.com.
# The owner is defined consistently in src/lib/adminAccess.ts and firestore.rules.
# Do not put administrator passwords in VITE_* variables (they are public).

# EmailJS Service Integration (for automatic confirmation & owner alert emails)
# Register and configure at https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_CONFIRMATION=
VITE_EMAILJS_TEMPLATE_ALERT=
