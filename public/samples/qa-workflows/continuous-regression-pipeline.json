{
  "name": "Continuous Regression Pipeline",
  "version": "2.0.0",
  "description": "Production QA Automation Pipeline: Git Commit Trigger -> Playwright E2E Tests -> Artifact Reporting -> Team Notification",
  "owner": "Tech_Studio QE Practice",
  "trigger": {
    "type": "github_actions",
    "event": ["pull_request", "push"],
    "branches": ["main", "staging", "release/*"],
    "paths_ignore": ["docs/**", "*.md"]
  },
  "environment_variables": {
    "NODE_ENV": "test",
    "BASE_URL": "${{ secrets.STAGING_URL }}",
    "TEST_USER_EMAIL": "${{ secrets.TEST_USER_EMAIL }}",
    "TEST_USER_PASSWORD": "${{ secrets.TEST_USER_PASSWORD }}",
    "SLACK_WEBHOOK_URL": "${{ secrets.SLACK_WEBHOOK_URL }}"
  },
  "pipeline": {
    "environment": "node:20-alpine",
    "concurrency": {
      "group": "regression-${{ github.ref }}",
      "cancel_in_progress": true
    },
    "matrix": {
      "browser": ["chromium", "firefox", "webkit"],
      "shard": [1, 2, 3, 4]
    },
    "steps": [
      {
        "name": "Checkout Code",
        "uses": "actions/checkout@v4"
      },
      {
        "name": "Setup Node.js",
        "uses": "actions/setup-node@v4",
        "with": { "node-version": "20", "cache": "npm" }
      },
      {
        "name": "Install Dependencies",
        "run": "npm ci"
      },
      {
        "name": "Install Playwright Browsers",
        "run": "npx playwright install --with-deps ${{ matrix.browser }}"
      },
      {
        "name": "Run Playwright E2E Tests",
        "run": "npx playwright test --project=${{ matrix.browser }} --shard=${{ matrix.shard }}/4",
        "timeout_minutes": 20,
        "retry": { "attempts": 2, "on": "failure" }
      },
      {
        "name": "Merge Test Reports",
        "run": "npx playwright merge-reports --reporter html ./blob-reports",
        "if": "always()"
      },
      {
        "name": "Publish Report",
        "uses": "actions/upload-artifact@v4",
        "if": "always()",
        "with": {
          "name": "playwright-report-${{ matrix.browser }}-${{ matrix.shard }}",
          "path": "playwright-report/",
          "retention-days": 14
        }
      },
      {
        "name": "Notify on Failure",
        "if": "failure()",
        "run": "curl -X POST -H 'Content-type: application/json' --data '{\"text\":\"Regression suite failed on ${{ github.ref_name }} — see run ${{ github.run_id }}\"}' $SLACK_WEBHOOK_URL"
      }
    ]
  },
  "quality_gates": {
    "min_pass_rate_percent": 98,
    "block_merge_on_failure": true,
    "flaky_test_quarantine": true
  },
  "reporting": {
    "formats": ["html", "junit", "json"],
    "dashboard": "artifact-report-index.html"
  }
}
